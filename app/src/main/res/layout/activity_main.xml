<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/space_deep"
    tools:context=".MainActivity">

    <com.example.yourfriend.ui.MagicBackgroundView
        android:id="@+id/magicBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/onboardingRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/view_onboarding" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/chatRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <include layout="@layout/view_chat" />
    </FrameLayout>

    <com.example.yourfriend.ui.SparkleBurstView
        android:id="@+id/sparkleBurst"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
