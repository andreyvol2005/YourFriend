<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/onboardingScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/ctaContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.example.yourfriend.ui.AvatarOrbView
                android:id="@+id/onboardingAvatar"
                android:layout_width="142dp"
                android:layout_height="142dp"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/onboardingEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.22"
                android:text="@string/onboarding_eyebrow"
                android:textColor="@color/aurora_pink"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/onboardingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:text="@string/onboarding_title"
                android:textColor="@color/text_primary"
                android:textSize="31sp" />

            <TextView
                android:id="@+id/onboardingSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/onboarding_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/stepIndicator"
                android:layout_width="wrap_content"
                android:layout_height="4dp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/stepDotOne"
                    android:layout_width="26dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_step_active" />

                <View
                    android:id="@+id/stepDotTwo"
                    android:layout_width="8dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_step_inactive" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stepGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.16"
                    android:text="@string/onboarding_step_one"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipChildren="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardFemale"
                        android:layout_width="0dp"
                        android:layout_height="148dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/iconFemale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:text="♀"
                            android:textColor="#FFB2D8"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/titleFemale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/onboarding_friend_female"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/hintFemale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/onboarding_friend_female_hint"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/cardMale"
                        android:layout_width="0dp"
                        android:layout_height="148dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/iconMale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:text="♂"
                            android:textColor="#8FE8FF"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/titleMale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/onboarding_friend_male"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/hintMale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/onboarding_friend_male_hint"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stepName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/nameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.16"
                    android:text="@string/onboarding_step_two_female"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp" />

                <LinearLayout
                    android:id="@+id/nameFieldContainer"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="12dp">

                    <EditText
                        android:id="@+id/nameInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/onboarding_name_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="18"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#66FFFFFF"
                        android:textSize="19sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:alpha="0.8"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_sparkle"
                        app:tint="@color/aurora_pink" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/onboarding_name_suggestion"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/suggestNameOne"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/suggestNameTwo"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/suggestNameThree"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/onboardingQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:alpha="0.72"
                android:fontFamily="serif"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Иногда одна фраза меняет весь вечер."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="italic" />

            <Space
                android:layout_width="1dp"
                android:layout_height="24dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/onboardingBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_circle"
        android:contentDescription="@string/chat_back"
        android:padding="11dp"
        android:src="@drawable/ic_arrow_back"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_primary" />

    <LinearLayout
        android:id="@+id/ctaContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ctaButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_button_gradient"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/onboarding_next"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/ctaHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="@string/onboarding_edit_later"
            android:textColor="@color/text_muted"
            android:textSize="9sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
